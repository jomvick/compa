[Desktop Entry]
Type=Application
Name=Compa
GenericName=Desktop Companion
Comment=A living Tux companion for Linux
# NOTE: this is a reference template with a relative Exec path — it only
# works if launched from within this project folder. Do NOT copy this file
# as-is into ~/.config/autostart/: it will fail to find companion.py there.
# Use the "Launch at session startup" toggle in Compa's Settings
# instead — it generates a working autostart entry with the correct
# absolute path automatically.
Exec=python3 companion.py
Icon=tux
Terminal=false
Categories=Utility;DesktopSettings;
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
