#!/bin/bash
# AppRun — entry point executed when the AppImage is launched.
# Runs from inside the mounted AppImage; $APPDIR is set by the AppImage
# runtime to the root of the bundled filesystem.

set -e
HERE="$(dirname "$(readlink -f "${0}")")"
APPDIR="${APPDIR:-$HERE}"

export PATH="${APPDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/$(uname -m)-linux-gnu:${LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="${APPDIR}/usr/lib/girepository-1.0:${GI_TYPELIB_PATH}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export PYTHONPATH="${APPDIR}/usr/lib/python3-libs:${PYTHONPATH}"

exec "${APPDIR}/usr/bin/python3" "${APPDIR}/usr/share/compa/companion.py" "$@"
